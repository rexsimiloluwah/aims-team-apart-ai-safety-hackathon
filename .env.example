# Copy to .env and fill in. .env is gitignored.

# --- GCP ---
GCE_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=cw-your-gcp-project-id        # globally unique, no underscores
GCE_ZONE=us-central1-a                    # override per-submit for GPU stockouts
GCE_IMAGE_FAMILY=common-cu129-ubuntu-2204-nvidia-580   # check it's current (see scripts)

# --- HuggingFace ---
HF_TOKEN=hf_xxx                           # required; passed explicitly to from_pretrained

# --- Weights & Biases (optional) ---
WANDB_API_KEY=
WANDB_PROJECT=confidently-wrong
WANDB_MODE=disabled                       # disabled | offline | online
